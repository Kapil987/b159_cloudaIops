# AWS credentials come from your normal AWS setup (aws configure, SSO, or env vars).
AWS_REGION=us-east-1

# Bedrock Knowledge Base (created in the console, see README)
KB_ID=
KB_DATA_SOURCE_ID=
S3_BUCKET=langraph-lawfirm-contracts-075213340617-us-east-1-an
S3_PREFIX=contracts/

# Chat model for the router / metadata agent / merge step
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# v2 only (matches v2_rag_plus_postgres/docker-compose.yml)
POSTGRES_DSN=postgresql://lawfirm:lawfirm@localhost:5433/lawfirm

# The "today" the demo pretends it is. Keep it, so answers stay the same.
AS_OF_DATE=2026-12-01


